  "moments": [
    {
      "date": "1768-08-26",
      "lat": 50.3,
      "lon": -4.15,
      "kind": "turning-point",
      "title": "Sealed orders",
      "text": "The Endeavour leaves Plymouth with ninety-four people aboard. The open orders say Tahiti, to observe the transit of Venus. The sealed ones send Cook on to look for the southern continent.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1769-01-16",
      "lat": -54.8,
      "lon": -65.05,
      "kind": "hardship",
      "title": "Snow on Tierra del Fuego",
      "text": "A botanizing party led by Joseph Banks is caught by snow in the hills above the Bay of Good Success. Two of Banks's servants, Thomas Richmond and George Dorlton, die of cold in the night.",
      "isQuote": false,
      "sourceId": "beaglehole"
    },
    {
      "date": "1769-04-13",
      "lat": -17.48,
      "lon": -149.5,
      "kind": "landfall",
      "title": "Tahiti",
      "text": "The Endeavour anchors in Matavai Bay. Cook sets rules for trading with Tahitians, and the crew build a small fort for the instruments at a point they call Point Venus.",
      "isQuote": false,
      "sourceId": "wharton",
      "slowMotion": true
    },
    {
      "date": "1769-06-03",
      "lat": -17.48,
      "lon": -149.5,
      "kind": "journal",
      "title": "The transit of Venus",
      "text": "Under a clear sky the observers time Venus crossing the sun. A dark smear where the planet meets the sun's edge makes the timings disagree, and the measurement is never as exact as hoped.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1769-07-13",
      "lat": -17.48,
      "lon": -149.5,
      "kind": "encounter",
      "title": "Tupaia",
      "text": "Tupaia, a priest and navigator from Ra'iatea, joins the ship. From memory he draws a chart of some seventy islands around Tahiti, and guides Cook through the islands to the west.",
      "isQuote": false,
      "sourceId": "beaglehole"
    },
    {
      "date": "1769-09-02",
      "lat": -40.3,
      "lon": -147.5,
      "kind": "turning-point",
      "title": "No continent",
      "text": "Following the sealed orders south to 40°, Cook finds only great swells rolling from the south, which tell him there is no large land nearby. He turns west.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1769-10-07",
      "lat": -38.85,
      "lon": 178.4,
      "kind": "landfall",
      "title": "Land from the masthead",
      "text": "Nicholas Young, the surgeon's boy, sights land: the coast of New Zealand, which no European has seen since Tasman's brief visit to the other side in 1642. Cook names the headland Young Nick's Head.",
      "isQuote": false,
      "sourceId": "wharton",
      "slowMotion": true
    },
    {
      "date": "1769-10-09",
      "lat": -38.72,
      "lon": 178.05,
      "kind": "encounter",
      "title": "Tūranganui-a-Kiwa",
      "text": "The first meetings with Māori go badly wrong, and several Māori men are shot dead over two days. Tupaia finds he can talk with them: his language and theirs are close kin.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1769-11-09",
      "lat": -36.78,
      "lon": 175.85,
      "kind": "journal",
      "title": "The transit of Mercury",
      "text": "At the bay he names for it, Cook observes Mercury cross the sun and fixes the ship's longitude, so that his chart of the coast can be placed exactly.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1770-01-15",
      "lat": -41.09,
      "lon": 174.25,
      "kind": "encounter",
      "title": "Tōtaranui",
      "text": "At Ship Cove in Queen Charlotte Sound the crew refit the ship among Māori who come to trade. From a hilltop Cook sees open water to the east: a strait divides the land in two.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1770-03-31",
      "lat": -40.85,
      "lon": 173.85,
      "kind": "turning-point",
      "title": "Two islands, charted",
      "text": "After six months and about 3,800 kilometres of coast, Cook has sailed all the way around New Zealand. It is two islands, not a corner of a continent.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1770-04-19",
      "lat": -37.85,
      "lon": 149.45,
      "kind": "landfall",
      "title": "New Holland",
      "text": "Lieutenant Zachary Hicks sights the east coast of the land the Dutch called New Holland. Cook turns north to follow it.",
      "isQuote": false,
      "sourceId": "wharton",
      "slowMotion": true
    },
    {
      "date": "1770-04-29",
      "lat": -34.0,
      "lon": 151.22,
      "kind": "encounter",
      "title": "Kamay",
      "text": "Two Gweagal men stand on the shore to stop the landing. Cook fires on them and wounds one. Ashore, Banks and the botanists collect so many new plants that Cook names the inlet Botany Bay.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1770-06-11",
      "lat": -15.78,
      "lon": 145.57,
      "kind": "hardship",
      "title": "On the reef",
      "text": "Near eleven at night the Endeavour runs onto the Great Barrier Reef. Guns and ballast go overboard, and a sail packed with wool and oakum is drawn under the hull to stop the leak.",
      "isQuote": false,
      "sourceId": "wharton",
      "slowMotion": true
    },
    {
      "date": "1770-07-10",
      "lat": -15.45,
      "lon": 145.3,
      "kind": "encounter",
      "title": "Waalumbaal Birri",
      "text": "Repairing the ship in the river, the crew meet the Guugu Yimithirr people, from whom they learn the word gangurru, kangaroo. A dispute over turtles ends in a peace made by an old man.",
      "isQuote": false,
      "sourceId": "beaglehole"
    },
    {
      "date": "1770-08-22",
      "lat": -10.7,
      "lon": 142.35,
      "kind": "turning-point",
      "title": "Possession",
      "text": "On a small island off Cape York, Cook claims the whole east coast for King George III, without asking anyone who lived there.",
      "isQuote": false,
      "sourceId": "wharton"
    },
    {
      "date": "1770-12-20",
      "lat": -6.05,
      "lon": 106.8,
      "kind": "hardship",
      "title": "Batavia",
      "text": "In the Dutch port malaria and dysentery spread through the crew. Tupaia dies, and his young companion Taiata before him. By the time the ship reaches the Cape, some thirty more have died.",
      "isQuote": false,
      "sourceId": "beaglehole"
    },
    {
      "date": "1771-07-13",
      "lat": 51.25,
      "lon": 1.5,
      "kind": "landfall",
      "title": "Home",
      "text": "Almost three years after leaving Plymouth, the Endeavour anchors in the Downs. The continent was not found; the charts of New Zealand and eastern Australia were made.",
      "isQuote": false,
      "sourceId": "wharton",
      "slowMotion": true
    }
  ],
