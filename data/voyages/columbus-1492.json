  "moments": [
    {
      "date": "1492-08-03", "lat": 37.18, "lon": -6.95, "kind": "turning-point",
      "title": "Half an hour before sunrise",
      "text": "The Santa María, the Pinta and the Niña cross the bar of Saltes and set a course for the Canaries, the last Castilian port before the open ocean.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-09-09", "lat": 27.9, "lon": -18.6, "kind": "journal",
      "title": "Two reckonings",
      "text": "With El Hierro out of sight, Columbus starts keeping two counts of the distance run: the true one for himself and a shorter one for the crew, so the voyage will not seem so long.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-09-16", "lat": 28.2, "lon": -33.6, "kind": "journal",
      "title": "Green weed on the water",
      "text": "They meet great rafts of weed in the open sea. The crews take it as a sign of land nearby. It is the Sargasso Sea, and the nearest land is weeks away.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-09-25", "lat": 27.2, "lon": -47.5, "kind": "hardship",
      "title": "Land that was not there",
      "text": "At sunset Martín Alonso Pinzón calls out from the Pinta that he sees land, and the crews sing the Gloria. By morning it is clear it was only cloud.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-10-10", "lat": 24.7, "lon": -71.0, "kind": "hardship",
      "title": "The men can bear no more",
      "text": "After more than a month out of sight of land the crews complain openly about the length of the voyage. Columbus urges them on with the promise of what they will gain.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-10-12", "lat": 24.05, "lon": -74.57, "kind": "landfall",
      "title": "Land, two leagues off",
      "text": "Two hours after midnight a sailor on the Pinta, Rodrigo de Triana, sights land in the moonlight. The ships wait for day. Which island this was is still argued: San Salvador is the traditional answer, Samana Cay the best-known rival.",
      "isQuote": false, "sourceId": "lascasas", "slowMotion": true,
      "candidates": [
        { "name": "San Salvador (Watling's Island)", "lat": 24.05, "lon": -74.5, "sourceId": "morison" },
        { "name": "Samana Cay", "lat": 23.06, "lon": -73.74, "sourceId": "judge" },
        { "name": "Grand Turk", "lat": 21.47, "lon": -71.14 }
      ]
    },
    {
      "date": "1492-10-12", "lat": 24.05, "lon": -74.5, "kind": "encounter",
      "title": "Guanahani",
      "text": "The island already has a name. Its Lucayan Taíno people call it Guanahani and come out to meet the ships. Columbus renames it San Salvador, and in the same day's entry writes that they would make good servants. Within days he takes several aboard as guides.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-10-28", "lat": 21.15, "lon": -76.0, "kind": "landfall",
      "title": "Cuba",
      "text": "The Taíno guides have spoken of a great island to the south. Columbus is sure it must be Cipangu, or the mainland of Cathay itself, and he writes that he has never seen a more beautiful country.",
      "isQuote": false, "sourceId": "lascasas", "slowMotion": true
    },
    {
      "date": "1492-11-02", "lat": 21.15, "lon": -76.0, "kind": "encounter",
      "title": "An embassy to the Great Khan",
      "text": "Columbus sends Luis de Torres, who speaks Arabic and Hebrew, inland with letters for the Great Khan. They find no khan, only Taíno towns, and people who roll dried leaves and breathe in the smoke.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1492-12-06", "lat": 19.86, "lon": -73.42, "kind": "landfall",
      "title": "La Española",
      "text": "Across the strait from Cuba lies a mountainous island that reminds Columbus of Castile. He calls it La Española. Its people call it Ayiti.",
      "isQuote": false, "sourceId": "lascasas", "slowMotion": true
    },
    {
      "date": "1492-12-25", "lat": 19.83, "lon": -72.12, "kind": "hardship",
      "title": "Christmas on the reef",
      "text": "Near midnight, with a boy at the helm, the Santa María runs gently onto a reef and cannot be saved. The cacique Guacanagarí sends canoes and his own people to help unload her.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-01-02", "lat": 19.83, "lon": -72.12, "kind": "turning-point",
      "title": "La Navidad",
      "text": "With one ship fewer, Columbus leaves thirty-nine men ashore in a fort built from the Santa María's timbers. None of them will be alive when he returns in November.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-01-13", "lat": 19.1, "lon": -69.35, "kind": "encounter",
      "title": "The Gulf of Arrows",
      "text": "On the shore of Samaná a trade with Ciguayo men turns into a fight. Two of them are wounded. Columbus names the bay for their arrows.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-02-14", "lat": 37.25, "lon": -31.0, "kind": "hardship",
      "title": "A message in a cask",
      "text": "In a storm he expects to drown in, Columbus writes an account of what he has found, wraps it in waxed cloth, seals it in a barrel and throws it overboard.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-02-18", "lat": 37.03, "lon": -25.15, "kind": "landfall",
      "title": "Santa Maria, the Azores",
      "text": "Half the crew go ashore to give thanks for surviving the storm and are arrested by the Portuguese captain of the island. They are released a few days later.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-03-04", "lat": 38.69, "lon": -9.22, "kind": "turning-point",
      "title": "Lisbon",
      "text": "A second storm drives the Niña into the Tagus. King João II, who once turned Columbus down, receives him and hears where he has been.",
      "isQuote": false, "sourceId": "lascasas"
    },
    {
      "date": "1493-03-15", "lat": 37.18, "lon": -6.95, "kind": "landfall",
      "title": "Home to Palos",
      "text": "At midday the Niña crosses the bar of Saltes, 224 days after leaving it. The Pinta comes in on the same tide.",
      "isQuote": false, "sourceId": "lascasas", "slowMotion": true
    }
  ],
