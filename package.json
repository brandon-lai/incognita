{
  "name": "incognita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "fetch-data": "tsx scripts/bake/fetch.ts",
    "bake": "tsx scripts/bake/index.ts",
    "e2e": "node scripts/e2e.mjs",
    "bake:world": "tsx scripts/bake/world.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "fast-png": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@9.15.2"
}
